{
  "name": "HiTrade",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {"openFiles": ["README.md", "app.py"]},
    "vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance"]}
  },
  "postCreateCommand": "python -m pip install -r requirements-dev.txt",
  "postAttachCommand": {"server": "python -m streamlit run app.py --server.address 0.0.0.0"},
  "portsAttributes": {"8501": {"label": "HiTrade", "onAutoForward": "openPreview"}},
  "forwardPorts": [8501]
}
